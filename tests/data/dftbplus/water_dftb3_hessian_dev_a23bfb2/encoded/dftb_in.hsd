Geometry = xyzFormat {
  <<< "geometry.xyz"
}
Hamiltonian = DFTB {
  Scc = Yes
  Charge = 0
  ThirdOrderFull = Yes
  HubbardDerivs {
    O = -0.1575
    H = -0.1857
  }
  HCorrection = Damping {
    Exponent = 4.0
  }
  MaxAngularMomentum {
    O = "p"
    H = "s"
  }
  SlaterKosterFiles = Type2FileNames {
    Prefix = "/opt/dftb-params/3ob-3-1/"
    Separator = "-"
    Suffix = ".skf"
  }
  SCCTolerance = 1e-08
}
Options {
  WriteResultsTag = Yes
}
ParserOptions {
  ParserVersion = 14
}
Driver = SecondDerivatives {
  Atoms = 1:-1
  Delta = 0.0001
}
